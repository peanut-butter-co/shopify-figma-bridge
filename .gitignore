# Whitelist approach: ignore everything, then un-ignore tooling files.
# This lets us have a Shopify theme in the same directory for testing
# without committing any theme code.

# Ignore everything
*

# Un-ignore the tooling
!.gitignore
!README.md
!CLAUDE.md
!install.sh
!LICENSE

!.claude/
!.claude/figma-best-practices.md

# Project-level plugin config (committed so plugins like Superpowers are enabled for this project).
# Personal overrides stay in .claude/settings.local.json, which remains ignored.
!.claude/settings.json

# Skills (new skills directory)
!.claude/skills/
!.claude/skills/*/
!.claude/skills/*/SKILL.md
!.claude/skills/*/gotchas.md
!.claude/skills/*/reference/
!.claude/skills/*/reference/*.md
!.claude/skills/*/evals/
!.claude/skills/*/evals/*.json

# Scripts (committed pipeline tooling)
!.claude/scripts/
!.claude/scripts/*.js

# Theme fixture for the validate-shopify end-to-end harness (committed so the harness is
# reproducible; the real Shopify theme in the project root stays ignored by the `*` catch-all).
!.claude/scripts/fixtures/
!.claude/scripts/fixtures/**

# Docs
!docs/
!docs/**

# Theme profiles (pre-loaded knowledge, committed)
!.claude/figma-sync/
!.claude/figma-sync/theme-profiles/
!.claude/figma-sync/theme-profiles/*.json
!.claude/figma-sync/theme-profiles/README.md

# Test fixture (committed so the skills test harness in .claude/scripts/ is reproducible).
# The runtime manifest.json and the generated proposal.html stay ignored.
!.claude/figma-sync/manifest-test.json

# Always ignore runtime state (generated per project).
# (Also caught by the catch-all `*`, but name them explicitly so the protection
# survives any future restructuring of the figma-sync whitelist above.)
.claude/figma-sync/manifest.json
.claude/figma-sync/proposal.html

# macOS folder-metadata noise — ignore everywhere, even inside whitelisted dirs (e.g. docs/**).
# Placed last so it wins over the docs/** re-include (last matching pattern wins).
.DS_Store
